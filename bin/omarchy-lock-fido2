#!/bin/bash

# omarchy-lock-fido2 -- companion command for the erijl.lock plugin.
#
#   setup    write /etc/pam.d/omarchy-lock-fido2  (the only step that needs root)
#   remove   take it away again
#   doctor   explain why the key is or is not being offered at the lock screen
#   rebase   three-way merge this fork onto a newer built-in lock plugin
#
# Nothing here runs by itself. The shell never executes plugin code outside
# QML, and installing a plugin never asks for privileges -- so the one step
# that touches /etc is a command you run deliberately, and can read first.

set -euo pipefail

PLUGIN_ID="erijl.lock"
PAM_SERVICE="/etc/pam.d/omarchy-lock-fido2"
AUTHFILE="/etc/fido2/fido2"
PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
OMARCHY_LOCK_DIR="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock"
UPSTREAM_FILES=(Service.qml LockView.qml manifest.json)

ASSUME_YES=0
FORCE=0
FAILURES=0

# ------------------------------------------------------------------ output

if [[ -t 1 ]]; then
  BOLD=$'\e[1m'; DIM=$'\e[2m'; RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; RESET=$'\e[0m'
else
  BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""; RESET=""
fi

heading() { printf '\n%s%s%s\n' "$BOLD" "$1" "$RESET"; }
ok()      { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
warn()    { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$1"; }
bad()     { printf '  %s✗%s %s\n' "$RED" "$RESET" "$1"; FAILURES=$((FAILURES + 1)); }
note()    { printf '    %s%s%s\n' "$DIM" "$1" "$RESET"; }
fail()    { printf '%somarchy-lock-fido2: %s%s\n' "$RED" "$1" "$RESET" >&2; exit 1; }

interactive() { [[ -t 0 && -t 1 ]]; }

confirm() {
  (( ASSUME_YES )) && return 0
  if command -v gum >/dev/null 2>&1 && interactive; then
    gum confirm "$1"
  elif interactive; then
    local answer
    read -r -p "$1 [y/N] " answer
    [[ $answer == [yY]* ]]
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

# ------------------------------------------------------------------ setup

pam_module_path() {
  local dir
  for dir in /usr/lib/security /usr/lib64/security /lib/security /usr/lib/x86_64-linux-gnu/security; do
    [[ -f "$dir/pam_u2f.so" ]] && { echo "$dir/pam_u2f.so"; return 0; }
  done
  return 1
}

pam_service_body() {
  cat <<'PAM'
#%PAM-1.0
# Security-key unlock for the Omarchy lock screen (plugin: erijl.lock).
#
# Its own service on purpose. Adding `sufficient pam_u2f.so` to
# omarchy-lock-password instead would send every mistyped password to the key
# as a PIN attempt, and a key has only eight of those before it locks itself
# out and needs a factory reset that destroys every credential on it.
#
# `required` with no pam_unix fallback: the way back to a password is the mode
# switch in the UI, not a silent fall-through.
#
# No pinverification=1 here. pam_u2f ORs that module option with the
# per-credential flag, so setting it would force a PIN onto keys registered
# without one. Verification requirements belong on the credential.
auth       required    pam_u2f.so authfile=/etc/fido2/fido2 cue [cue_prompt=Touch your security key]
account    include     system-local-login
PAM
}

cmd_setup() {
  local module
  if ! module=$(pam_module_path); then
    bad "pam_u2f.so is not installed"
    note "sudo pacman -S --needed pam-u2f libfido2"
    exit 1
  fi
  ok "pam_u2f.so found at $module"

  if [[ -f $PAM_SERVICE ]]; then
    if (( ! FORCE )) && grep -q 'pam_u2f\.so' "$PAM_SERVICE"; then
      ok "$PAM_SERVICE already exists and loads pam_u2f"
      note "rewrite it with: $0 setup --force"
      echo
      cmd_doctor
      return
    fi

    echo "$PAM_SERVICE already exists. The difference from what this would write:"
    echo
    diff -u "$PAM_SERVICE" <(pam_service_body) || true
    echo
    confirm "Replace $PAM_SERVICE?" || fail "aborted"
  fi

  echo "Writing $PAM_SERVICE (this is the sudo prompt)..."
  pam_service_body | sudo tee "$PAM_SERVICE" >/dev/null
  sudo chown root:root "$PAM_SERVICE"
  sudo chmod 644 "$PAM_SERVICE"
  ok "wrote $PAM_SERVICE"

  echo
  cmd_doctor
}

cmd_remove() {
  if [[ ! -e $PAM_SERVICE ]]; then
    ok "$PAM_SERVICE is already gone"
  else
    confirm "Delete $PAM_SERVICE? The lock screen stops offering the key." || fail "aborted"
    sudo rm -f "$PAM_SERVICE"
    ok "removed $PAM_SERVICE"
  fi

  echo
  echo "The plugin itself is separate:"
  note "omarchy plugin disable $PLUGIN_ID   # back to the built-in lock screen"
  note "omarchy plugin remove  $PLUGIN_ID   # and take the files away too"
}

# ------------------------------------------------------------------ doctor

check_pam() {
  heading "PAM service"

  if [[ ! -f $PAM_SERVICE ]]; then
    bad "$PAM_SERVICE is missing -- the lock screen cannot offer the key"
    note "$0 setup"
    return
  fi
  ok "$PAM_SERVICE exists"

  if grep -q 'pam_u2f\.so' "$PAM_SERVICE"; then
    local authfile
    authfile=$(grep -oP 'authfile=\K[^ ]+' "$PAM_SERVICE" | head -1)
    ok "loads pam_u2f with authfile=${authfile:-<default>}"
    [[ -n $authfile && $authfile != "$AUTHFILE" ]] &&
      warn "that is not $AUTHFILE, so the checks below may be looking at the wrong file"
  else
    bad "$PAM_SERVICE does not load pam_u2f.so"
  fi

  if grep -qE '^\s*auth\s+sufficient\s+pam_u2f' "$PAM_SERVICE"; then
    warn "pam_u2f is 'sufficient' here; 'required' is what this plugin expects"
  fi

  if grep -q 'pinverification=1' "$PAM_SERVICE"; then
    warn "pinverification=1 is set module-wide"
    note "pam_u2f ORs it with the per-credential flag, forcing a PIN onto keys registered without one"
  fi

  local owner
  owner=$(stat -c '%U:%G %a' "$PAM_SERVICE")
  if [[ $owner == "root:root 644" ]]; then
    ok "owned root:root, mode 644"
  else
    warn "unexpected ownership/mode: $owner (want root:root 644)"
  fi
}

check_credentials() {
  heading "Credentials"

  if [[ ! -f $AUTHFILE ]]; then
    bad "$AUTHFILE does not exist -- no key is enrolled"
    note "enroll one first: omarchy setup security fido2"
    return
  fi

  local owner
  owner=$(stat -c '%U:%G' "$AUTHFILE")
  if [[ $owner == "root:root" ]]; then
    ok "$AUTHFILE owned root:root"
  else
    warn "$AUTHFILE is owned by $owner, not root:root"
    note "anyone who can write it can enroll their own key: sudo chown root:root $AUTHFILE"
  fi

  local line
  if ! line=$(grep -m1 "^$USER:" "$AUTHFILE"); then
    bad "no credential for '$USER' in $AUTHFILE"
    note "the file exists but this account has no key enrolled"
    return
  fi

  local -a credentials
  IFS=':' read -r -a credentials <<<"$line"
  local count=$((${#credentials[@]} - 1))
  (( count > 0 )) && ok "$count credential(s) enrolled for $USER" || bad "no credential fields for $USER"

  CREDENTIALS_WANT_PIN=0
  local index options
  for (( index = 1; index < ${#credentials[@]}; index++ )); do
    options=$(cut -d, -f4 <<<"${credentials[index]}")
    printf '    %s#%d %s%s\n' "$DIM" "$index" "${options:-<none>}" "$RESET"
    [[ $options == *"+pin"* || $options == *"+verification"* ]] && CREDENTIALS_WANT_PIN=1
  done
}

check_hardware() {
  heading "Authenticators"

  if ! command -v fido2-token >/dev/null 2>&1; then
    bad "fido2-token is not installed (package: libfido2)"
    return
  fi

  local -a devices
  mapfile -t devices < <(fido2-token -L 2>/dev/null | cut -d: -f1)

  if (( ${#devices[@]} == 0 )); then
    warn "no authenticator attached right now"
    note "that is fine -- the lock screen says so and waits, and notices one plugged in later"
    return
  fi

  TOKEN_ALWAYS_UV=0
  local device info
  for device in "${devices[@]}"; do
    info=$(fido2-token -I "$device" 2>/dev/null || true)
    if [[ -z $info ]]; then
      warn "$device did not answer fido2-token -I"
      continue
    fi

    local traits=()
    if grep -qE '(^|[ ,])alwaysUv([ ,]|$)' <<<"$info"; then
      traits+=("alwaysUv")
      TOKEN_ALWAYS_UV=1
    fi
    grep -qE '(^|[ ,])clientPin([ ,]|$)' <<<"$info" && traits+=("PIN set")
    grep -qE '(^|[ ,])noclientPin([ ,]|$)' <<<"$info" && traits+=("no PIN set")

    local retries
    retries=$(grep -oP 'pin retries:\s*\K[0-9]+' <<<"$info" | head -1 || true)
    [[ -n $retries ]] && traits+=("$retries PIN retries left")

    ok "$device -- ${traits[*]:-no notable options}"
    [[ -n $retries && $retries -le 3 ]] &&
      warn "only $retries PIN retries left on $device; at 0 the key factory-resets"
  done
}

check_pin_policy() {
  # The failure this plugin exists next to: a key that demands verification for
  # every assertion, against a credential registered without any.
  (( ${TOKEN_ALWAYS_UV:-0} )) || return 0
  (( ${CREDENTIALS_WANT_PIN:-0} )) && return 0

  heading "The alwaysUv mismatch"
  bad "an attached key enforces alwaysUv, but the enrolled credential asks for no PIN"
  note "pam_u2f will request an assertion with verification off, the key will refuse it"
  note "before it ever lights up, and the unlock will fail without a single blink."
  note ""
  note "Re-enroll that key with PIN verification recorded on the credential:"
  note "  pamu2fcfg -N -n | sudo tee -a $AUTHFILE"
  note "(-N records +pin; -n appends without repeating the username field)"
}

check_plugin() {
  heading "Plugin"

  if ! command -v omarchy-plugin-list >/dev/null 2>&1; then
    warn "omarchy-plugin-list not found; skipping plugin checks"
    return
  fi

  local entry
  entry=$(omarchy-plugin-list --json 2>/dev/null | jq -c --arg id "$PLUGIN_ID" 'map(select(.id == $id))[0] // empty' || true)

  if [[ -z $entry ]]; then
    bad "$PLUGIN_ID is not installed"
    note "omarchy plugin add https://github.com/Erijl/omarchy-fido2-lockscreen-plugin.git --enable"
    return
  fi
  ok "$PLUGIN_ID is installed"

  if [[ $(jq -r '.enabled' <<<"$entry") == "true" ]]; then
    ok "enabled"
  else
    bad "installed but not enabled -- the built-in lock screen is still in charge"
    note "omarchy plugin enable $PLUGIN_ID"
  fi

  local status
  status=$(omarchy-shell lock status 2>/dev/null || true)
  if ! jq -e . >/dev/null 2>&1 <<<"$status"; then
    warn "the shell did not answer 'lock status'"
    note "is omarchy-shell running? try: omarchy restart shell"
    return
  fi

  if [[ $(jq -r 'has("fido2Pam")' <<<"$status") != "true" ]]; then
    bad "the running lock service has no FIDO2 support"
    note "the built-in plugin is loaded, not this one; omarchy restart shell"
    return
  fi

  printf '    %s%s%s\n' "$DIM" \
    "$(jq -r '"pam=\(.fido2Pam)  enrolled=\(.fido2Enrolled)  keyAttached=\(.fido2Token)  defaultMode=\(.defaultMode)"' <<<"$status")" \
    "$RESET"

  [[ $(jq -r '.fido2 // false' <<<"$status") == "true" ]] &&
    ok "the lock screen will offer the key" ||
    warn "the lock screen will not offer the key yet (see above)"
}

check_upstream() {
  heading "Upstream"

  local base="$PLUGIN_DIR/upstream/BASE"
  if [[ ! -f $base ]]; then
    warn "upstream/BASE is missing; cannot tell whether this fork is current"
    return
  fi

  local recorded_version
  recorded_version=$(grep -oP '^omarchy_version=\K.*' "$base" || echo "unknown")
  local installed_version="unknown"
  [[ -f "${OMARCHY_PATH:-/usr/share/omarchy}/version" ]] &&
    installed_version=$(<"${OMARCHY_PATH:-/usr/share/omarchy}/version")

  if [[ ! -d $OMARCHY_LOCK_DIR ]]; then
    warn "$OMARCHY_LOCK_DIR not found; skipping the drift check"
    return
  fi

  local drift=0 file recorded current
  for file in "${UPSTREAM_FILES[@]}"; do
    recorded=$(grep -oP "^sha256_$file=\K.*" "$base" || true)
    current=$(sha256sum "$OMARCHY_LOCK_DIR/$file" 2>/dev/null | cut -d' ' -f1)
    [[ -n $recorded && $recorded == "$current" ]] || { drift=1; warn "$file has changed upstream"; }
  done

  if (( drift )); then
    bad "Omarchy's lock plugin has moved since this fork was taken ($recorded_version -> $installed_version)"
    note "this fork is missing whatever changed. Look, then merge:"
    note "  diff -u $PLUGIN_DIR/upstream/Service.qml $OMARCHY_LOCK_DIR/Service.qml"
    note "  $0 rebase"
  else
    ok "fork is current with the installed lock plugin ($recorded_version)"
  fi
}

cmd_doctor() {
  check_plugin
  check_pam
  check_credentials
  check_hardware
  check_pin_policy
  check_upstream

  echo
  if (( FAILURES )); then
    printf '%s%d problem(s) above.%s\n' "$RED" "$FAILURES" "$RESET"
    return 1
  fi
  printf '%sAll good.%s\n' "$GREEN" "$RESET"
}

# ------------------------------------------------------------------ rebase

cmd_rebase() {
  local base="$PLUGIN_DIR/upstream/BASE"
  [[ -f $base ]] || fail "upstream/BASE is missing"
  [[ -d $OMARCHY_LOCK_DIR ]] || fail "$OMARCHY_LOCK_DIR not found"
  command -v git >/dev/null 2>&1 || fail "git is required"

  git -C "$PLUGIN_DIR" rev-parse --git-dir >/dev/null 2>&1 ||
    fail "$PLUGIN_DIR is not a git checkout; rebase writes conflict markers and needs an undo"
  [[ -z $(git -C "$PLUGIN_DIR" status --porcelain) ]] ||
    fail "working tree is dirty; commit or stash first so this is undoable"

  local file recorded current conflicts=0 changed=0
  for file in "${UPSTREAM_FILES[@]}"; do
    recorded=$(grep -oP "^sha256_$file=\K.*" "$base" || true)
    current=$(sha256sum "$OMARCHY_LOCK_DIR/$file" | cut -d' ' -f1)

    if [[ $recorded == "$current" ]]; then
      ok "$file unchanged upstream"
      continue
    fi

    changed=1
    if git merge-file -L "this fork" -L "fork base" -L "new upstream" \
      "$PLUGIN_DIR/$file" "$PLUGIN_DIR/upstream/$file" "$OMARCHY_LOCK_DIR/$file"; then
      ok "$file merged cleanly"
    else
      conflicts=1
      warn "$file merged with conflicts -- resolve the <<<<<<< markers by hand"
    fi
    cp -- "$OMARCHY_LOCK_DIR/$file" "$PLUGIN_DIR/upstream/$file"
  done

  if (( ! changed )); then
    echo
    echo "Nothing to do -- the fork base already matches the installed lock plugin."
    return 0
  fi

  local version="unknown" commit="unknown"
  [[ -f "${OMARCHY_PATH:-/usr/share/omarchy}/version" ]] &&
    version=$(<"${OMARCHY_PATH:-/usr/share/omarchy}/version")
  commit=$(git ls-remote https://github.com/basecamp/omarchy quattro 2>/dev/null | cut -f1 || true)
  [[ -n $commit ]] || commit="unknown (offline; taken from the installed package)"

  {
    sed -e "s/^omarchy_version=.*/omarchy_version=$version/" \
      -e "s|^upstream_commit=.*|upstream_commit=$commit|" \
      -e "s/^forked_on=.*/forked_on=$(date -I)/" \
      -e "/^sha256_/d" "$base"
    for file in "${UPSTREAM_FILES[@]}"; do
      echo "sha256_$file=$(sha256sum "$PLUGIN_DIR/upstream/$file" | cut -d' ' -f1)"
    done
  } >"$base.new"
  mv -- "$base.new" "$base"
  ok "upstream/ and upstream/BASE updated to $version"

  echo
  echo "Next:"
  (( conflicts )) && note "resolve conflict markers, they are in the plugin's own QML"
  note "$PLUGIN_DIR/test/all"
  note "lock the screen and try both factors before committing"
  note "git -C $PLUGIN_DIR diff"
}

# ------------------------------------------------------------------ main

usage() {
  cat <<USAGE
Usage: omarchy-lock-fido2 <command> [--yes] [--force]

  setup    write $PAM_SERVICE (asks for sudo)
  remove   delete it again
  doctor   check every link in the chain and explain what is missing
  rebase   three-way merge this fork onto a newer built-in lock plugin

Run 'doctor' first when the lock screen is not offering your key.
USAGE
}

command=""
while (( $# > 0 )); do
  case "$1" in
  setup | remove | doctor | rebase) command="$1"; shift ;;
  --yes | -y) ASSUME_YES=1; shift ;;
  --force) FORCE=1; shift ;;
  -h | --help) usage; exit 0 ;;
  *) fail "unknown argument: $1" ;;
  esac
done

case "$command" in
setup) cmd_setup ;;
remove) cmd_remove ;;
doctor) cmd_doctor ;;
rebase) cmd_rebase ;;
*) usage; exit 1 ;;
esac
